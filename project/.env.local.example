# CLOXTRO — Part 3 environment variables
# Copy to .env.local (already gitignored) and fill in real values from your
# Supabase project settings → API.

# Public — safe to ship in the browser bundle. Only ever used by
# lib/supabase/client.js and lib/supabase/server.js.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Never prefixed with NEXT_PUBLIC_, so Next.js never inlines
# it into client bundles. Used exclusively by lib/supabase/admin.js, which
# is imported only from route handlers under app/api/** (server code) —
# never from any "use client" component. Bypasses Row Level Security:
# treat it like a database root password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Part 4: affiliate webhook verification (SERVER-ONLY) ---
# Shared secret used to verify the HMAC-SHA256 signature on inbound
# conversion webhooks — see app/api/webhooks/affiliate/[network]/route.js
# and lib/affiliate/webhook-verify.js. Never sent to the browser, never
# logged. A network-specific secret can override this per network:
# AFFILIATE_WEBHOOK_SECRET_GENERIC=... (uppercased network name).
AFFILIATE_WEBHOOK_SECRET=a-long-random-shared-secret

# --- Part 5: admin step-up re-authentication (SERVER-ONLY) ---
# Signs the short-lived (10 min) step-up token issued by
# POST /api/admin/step-up after an admin re-enters their password — see
# lib/admin/step-up.js. Sensitive admin actions (partner credentials,
# tracking config, high-impact bulk mutations) require this token in
# addition to a normal admin session.
STEP_UP_SECRET=another-long-random-secret

# --- Part 5: AI provider (SERVER-ONLY, optional) ---
# No AI provider is wired to a real API by default in this phase — the
# built-in "local" provider (lib/ai/providers/local.js) does deterministic,
# rule-based intent extraction and needs no key. Setting AI_PROVIDER=openai
# (and OPENAI_API_KEY) switches lib/ai/provider.js to the OpenAI adapter —
# see PHASE-5-CONTEXT.md §34/§38 for what that adapter still needs filled
# in before real model calls will succeed.
AI_PROVIDER=local
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini in lib/ai/providers/openai.js if unset.
OPENAI_INTENT_MODEL=

# --- Part 5: scheduled automation (SERVER-ONLY) ---
# Authorizes calls to GET /api/cron/automation — see vercel.json, which
# schedules Vercel Cron to call that endpoint hourly with this value as
# a bearer token. Vercel automatically sends it when CRON_SECRET is set
# as a project environment variable; set it to any long random string.
CRON_SECRET=a-third-long-random-secret

# --- Part 6: canonical site URL (PUBLIC — used for SEO metadata, sitemap,
# robots.txt, and Open Graph URLs; not a secret) ---
# See lib/seo/site.js. Set this to the real production domain before
# deploying — app/sitemap.js, app/robots.js, and every page's
# alternates.canonical/openGraph.url read from it. Falls back to an
# obviously-fake placeholder if unset, so a forgotten value is easy to
# spot rather than silently shipping a wrong canonical host.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# --- Part 6: error tracking / monitoring (SERVER-ONLY, optional) ---
# No third-party error-tracking service is wired up in this codebase —
# lib/observability/logger.js emits structured JSON to stdout/stderr,
# which every serverless log drain (Vercel's included) already captures.
# Wiring a real provider (Sentry, Axiom, Better Stack, etc.) is a
# same-shape change confined to that one file's `emit()` function — see
# PHASE-6-CONTEXT.md §46 for what that requires and why it isn't done
# here (no DSN/credentials were supplied to this phase).
# SENTRY_DSN=

# --- Part 6: rate limiting (SERVER-ONLY, optional — production upgrade) ---
# lib/security/rate-limit.js ships a best-effort IN-MEMORY limiter that
# works per-server-process but is NOT a real distributed limit under
# serverless scale-out — see that file's header comment for the full
# explanation. Wiring a real shared store (Upstash Redis is the standard
# pairing with Vercel — @upstash/ratelimit) needs its own two env vars;
# left unset here since no such account/credentials were supplied to
# this phase.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
